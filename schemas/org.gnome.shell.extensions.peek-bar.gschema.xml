<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="gnome-shell-extensions">

  <schema path="/org/gnome/shell/extensions/peek-bar/" id="org.gnome.shell.extensions.peek-bar">

    <key type="b" name="intellihide-hide-from-windows">
      <default>true</default>
      <summary>Hide when active window overlaps panel</summary>
    </key>

    <key type="b" name="intellihide-use-pointer">
      <default>true</default>
      <summary>Reveal on pointer edge touch</summary>
    </key>
    <key type="b" name="intellihide-use-pointer-limit-size">
      <default>false</default>
      <summary>Limit reveal trigger to panel length</summary>
    </key>
    <key type="b" name="intellihide-revealed-hover">
      <default>true</default>
      <summary>Keep revealed while hovering</summary>
    </key>
    <key type="b" name="intellihide-revealed-hover-limit-size">
      <default>false</default>
      <summary>Limit hover zone to panel length</summary>
    </key>
    <key type="b" name="intellihide-use-pressure">
      <default>true</default>
      <summary>Require edge pressure to reveal</summary>
    </key>
    <key type="i" name="intellihide-pressure-threshold">
      <default>100</default>
      <summary>Pressure threshold (px)</summary>
    </key>
    <key type="i" name="intellihide-pressure-time">
      <default>1000</default>
      <summary>Pressure timeout (ms)</summary>
    </key>

    <key type="b" name="intellihide-show-in-fullscreen">
      <default>false</default>
      <summary>Allow reveal while in fullscreen</summary>
    </key>

    <key type="b" name="intellihide-notify-reveal">
      <default>true</default>
      <summary>Reveal panel on new notification</summary>
    </key>
    <key type="i" name="intellihide-notify-duration">
      <default>4000</default>
      <summary>Notification reveal duration (ms)</summary>
    </key>

    <key type="i" name="intellihide-animation-time">
      <default>200</default>
      <summary>Animation duration (ms)</summary>
    </key>
    <key type="i" name="intellihide-close-delay">
      <default>200</default>
      <summary>Delay before hiding (ms)</summary>
    </key>
    <key type="i" name="intellihide-reveal-delay">
      <default>0</default>
      <summary>Delay before revealing (ms)</summary>
    </key>

    <key type="s" name="intellihide-key-toggle-text">
      <default>"&lt;Super&gt;r"</default>
      <summary>Toggle shortcut (display text)</summary>
    </key>
    <key type="as" name="intellihide-key-toggle">
      <default><![CDATA[['<Super>r']]]></default>
      <summary>Toggle shortcut (binding)</summary>
    </key>

    <key type="i" name="intellihide-persisted-state">
      <default>-1</default>
      <summary>Persisted hold status (-1 = disabled)</summary>
    </key>

    <key type="i" name="intellihide-enable-start-delay">
      <default>2000</default>
      <summary>Delay before enabling on startup (ms)</summary>
    </key>

    <key type="b" name="intellihide-startup-animation">
      <default>true</default>
      <summary>Animate panel on startup</summary>
    </key>

    <key type="b" name="show-quick-settings-toggle">
      <default>false</default>
      <summary>Show toggle in Control Center / Quick Settings</summary>
    </key>

  </schema>
</schemalist>
