<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <!-- interface-name BoxIntellihideOptions.ui -->
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.3"/>

  <object class="GtkAdjustment" id="intellihide_pressure_threshold_adjustment">
    <property name="lower">1</property>
    <property name="page-increment">100</property>
    <property name="step-increment">10</property>
    <property name="upper">9990</property>
  </object>
  <object class="GtkAdjustment" id="intellihide_pressure_time_adjustment">
    <property name="lower">1</property>
    <property name="page-increment">100</property>
    <property name="step-increment">10</property>
    <property name="upper">5000</property>
  </object>
  <object class="GtkAdjustment" id="intellihide_animation_time_adjustment">
    <property name="lower">10</property>
    <property name="page-increment">100</property>
    <property name="step-increment">10</property>
    <property name="upper">2000</property>
  </object>
  <object class="GtkAdjustment" id="intellihide_close_delay_adjustment">
    <property name="lower">0</property>
    <property name="page-increment">100</property>
    <property name="step-increment">10</property>
    <property name="upper">4000</property>
  </object>
  <object class="GtkAdjustment" id="intellihide_reveal_delay_adjustment">
    <property name="lower">0</property>
    <property name="page-increment">100</property>
    <property name="step-increment">10</property>
    <property name="upper">4000</property>
  </object>
  <object class="GtkAdjustment" id="intellihide_enable_start_delay_adjustment">
    <property name="lower">0</property>
    <property name="page-increment">100</property>
    <property name="step-increment">10</property>
    <property name="upper">10000</property>
  </object>


  <object class="AdwPreferencesPage" id="page">
    <property name="title" translatable="yes">Peek Bar Options</property>
    <property name="icon-name">preferences-system-symbolic</property>

    <!-- Hide Behaviour -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Hide Behaviour</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Hide on window overlap</property>
            <property name="subtitle" translatable="yes">Automatically hide top bar when an active window touches it</property>
            <child>
              <object class="GtkSwitch" id="intellihide_window_hide_button">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwActionRow" id="intellihide_toggle_row">
            <property name="title" translatable="yes">Toggle shortcut</property>
            <property name="subtitle" translatable="yes">Permanently show or hide top bar</property>
            <property name="activatable">True</property>
            <child type="suffix">
              <object class="GtkShortcutLabel" id="intellihide_toggle_shortcut">
                <property name="valign">center</property>
                <property name="disabled-text" translatable="yes">Disabled</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Reveal Mechanism -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Reveal Mechanism</property>

        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Require edge pressure</property>
            <property name="subtitle" translatable="yes">Push cursor against top edge to reveal</property>
            <child>
              <object class="GtkSwitch" id="intellihide_use_pressure_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Pressure threshold (px)</property>
            <child>
              <object class="GtkSpinButton" id="intellihide_pressure_threshold_spinbutton">
                <property name="adjustment">intellihide_pressure_threshold_adjustment</property>
                <property name="numeric">True</property>
                <property name="valign">center</property>
                <property name="width-chars">4</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Pressure timeout (ms)</property>
            <child>
              <object class="GtkSpinButton" id="intellihide_pressure_time_spinbutton">
                <property name="adjustment">intellihide_pressure_time_adjustment</property>
                <property name="numeric">True</property>
                <property name="valign">center</property>
                <property name="width-chars">4</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Limit reveal trigger to panel length</property>
            <property name="subtitle" translatable="yes">Only trigger reveal when cursor touches top edge directly above panel</property>
            <child>
              <object class="GtkSwitch" id="intellihide_use_pointer_limit_size_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Keep revealed while hovering</property>
            <property name="subtitle" translatable="yes">Keep top bar open while mouse cursor stays over the panel</property>
            <child>
              <object class="GtkSwitch" id="intellihide_revealed_hover_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Limit hover zone to panel length</property>
            <property name="subtitle" translatable="yes">Only consider cursor hovering when directly over panel width</property>
            <child>
              <object class="GtkSwitch" id="intellihide_revealed_hover_limit_size_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Allow reveal in fullscreen</property>
            <property name="subtitle" translatable="yes">Allow top bar to reveal when apps are in fullscreen</property>
            <child>
              <object class="GtkSwitch" id="intellihide_show_in_fullscreen_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>

      </object>
    </child>





    <!-- Quick Settings -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Quick Settings Menu</property>

        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Show toggle in Quick Settings</property>
            <property name="subtitle" translatable="yes">Add a quick toggle switch in top bar menu</property>
            <child>
              <object class="GtkSwitch" id="show_quick_settings_toggle_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>

      </object>
    </child>

    <!-- Animations -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Animations</property>

        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Animation duration (ms)</property>
            <child>
              <object class="GtkSpinButton" id="intellihide_animation_time_spinbutton">
                <property name="adjustment">intellihide_animation_time_adjustment</property>
                <property name="numeric">True</property>
                <property name="valign">center</property>
                <property name="width-chars">4</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Hide delay (ms)</property>
            <child>
              <object class="GtkSpinButton" id="intellihide_close_delay_spinbutton">
                <property name="adjustment">intellihide_close_delay_adjustment</property>
                <property name="numeric">True</property>
                <property name="valign">center</property>
                <property name="width-chars">4</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Reveal delay (ms)</property>
            <child>
              <object class="GtkSpinButton" id="intellihide_reveal_delay_spinbutton">
                <property name="adjustment">intellihide_reveal_delay_adjustment</property>
                <property name="numeric">True</property>
                <property name="valign">center</property>
                <property name="width-chars">4</property>
              </object>
            </child>
          </object>
        </child>

      </object>
    </child>

    <!-- Startup -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Startup</property>

        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Animate on startup</property>
            <property name="subtitle" translatable="yes">Slide bar away on login instead of hiding instantly</property>
            <child>
              <object class="GtkSwitch" id="intellihide_startup_animation_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Startup delay (ms)</property>
            <child>
              <object class="GtkSpinButton" id="intellihide_enable_start_delay_spinbutton">
                <property name="adjustment">intellihide_enable_start_delay_adjustment</property>
                <property name="numeric">True</property>
                <property name="valign">center</property>
                <property name="width-chars">4</property>
              </object>
            </child>
          </object>
        </child>

      </object>
    </child>

    <!-- Reset Settings -->
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Reset</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Restore Default Settings</property>
            <property name="subtitle" translatable="yes">Reset all Peek Bar options to their default values</property>
            <child>
              <object class="GtkButton" id="reset_defaults_button">
                <property name="label" translatable="yes">Reset Defaults</property>
                <property name="valign">center</property>
                <style>
                  <class name="destructive-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

  </object>
</interface>
